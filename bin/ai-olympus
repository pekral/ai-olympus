#!/usr/bin/env php
<?php

// Try to find autoloader in different locations
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',                    // Development mode
    __DIR__ . '/../../../autoload.php',                     // Composer dependency
    __DIR__ . '/../../../../autoload.php',                  // Deeper nesting
];

$autoloadFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require $autoloadPath;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    fwrite(STDERR, "Could not find autoload.php. Make sure you're running this from a Composer project.\n");
    exit(1);
}

// The one place that actually spawns a process. An array command bypasses the shell
// entirely, so no per-OS quoting rule applies and a label or prompt containing spaces or
// quotes cannot be reinterpreted — the same call works on Linux, macOS, and Windows.
// The issue listing is captured because it is parsed; the agent run inherits STDOUT so a
// long session streams to the console instead of being buffered until it finishes.
$executor = static function (array $command, bool $captureOutput): Pekral\AiOlympus\CommandResult {
    $descriptors = $captureOutput ? [1 => ['pipe', 'w'], 2 => STDERR] : [1 => STDOUT, 2 => STDERR];
    $process = proc_open($command, $descriptors, $pipes);

    if (!is_resource($process)) {
        return new Pekral\AiOlympus\CommandResult(127, '');
    }

    if (!$captureOutput) {
        return new Pekral\AiOlympus\CommandResult(proc_close($process), '');
    }

    $output = (string) stream_get_contents($pipes[1]);
    fclose($pipes[1]);

    return new Pekral\AiOlympus\CommandResult(proc_close($process), $output);
};

exit(Pekral\AiOlympus\Cli::run($argv, $executor));
