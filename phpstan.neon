parameters:
    level: max
    paths:
        - src
        - tests
        - bin
    scanFiles:
        - skills/_shared/report-check-common.php
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false

    # Native class constant types need PHP 8.3, and the package supports PHP 8.2, so no constant carries one.
    type_coverage:
        constant_type: 0

    bootstrapFiles:
        - vendor/autoload.php