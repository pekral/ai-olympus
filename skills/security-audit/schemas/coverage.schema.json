{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage.schema.json",
  "title": "Security audit coverage ledger",
  "description": "coverage-ledger.json of a security-audit run. One entry per coverage unit (one attack class on one surface of one subsystem), written as the inventory before the first hunter opens, and one wave record per hunting wave with its coverage critic. scripts/audit-artifacts.sh validates it deterministically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "waves"],
  "properties": {
    "schema_version": { "const": 2 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "waves": {
      "type": "array",
      "items": { "$ref": "#/$defs/wave" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "coverage_id": { "type": "string", "pattern": "^C[1-9][0-9]*$" },
    "hunter_id": { "type": "string", "pattern": "^hunter-[1-9][0-9]*$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_id", "surface", "boundary", "subsystem", "attack_class", "paths", "status", "agent", "findings"],
      "properties": {
        "coverage_id": { "$ref": "#/$defs/coverage_id" },
        "surface": {
          "enum": [
            "http_entrypoint",
            "authentication",
            "authorization",
            "background_job",
            "queue",
            "webhook",
            "file_handling",
            "external_api",
            "data_isolation",
            "privileged_action",
            "ai_tool",
            "mcp_integration",
            "agent_side_effect",
            "frontend",
            "configuration",
            "ci_deploy",
            "dependency"
          ]
        },
        "boundary": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "subsystem": { "$ref": "#/$defs/text" },
        "attack_class": {
          "enum": ["auth_authz", "injection_input", "files_ssrf", "queues_webhooks", "data_isolation", "ai_tools", "wildcard"]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "status": { "enum": ["queued", "candidate", "covered", "blocked", "deferred", "out_of_scope"] },
        "agent": { "type": ["string", "null"], "pattern": "^hunter-[1-9][0-9]*$" },
        "findings": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
        },
        "reason": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "required": ["status"], "properties": { "status": { "enum": ["blocked", "deferred", "out_of_scope"] } } },
          "then": { "required": ["reason"] }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "enum": ["candidate", "covered"] } } },
          "then": { "properties": { "agent": { "type": "string" } } }
        }
      ]
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "hunters", "critic", "worktree", "gaps"],
      "properties": {
        "wave": { "type": "integer", "minimum": 1 },
        "hunters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hunter_id" }
        },
        "critic": { "type": "string", "pattern": "^critic-[1-9][0-9]*$" },
        "worktree": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail", "resolution"],
      "properties": {
        "kind": {
          "enum": ["missing_surface", "missing_attack_class", "uncovered_entrypoint", "unanalysed_boundary", "shallow_review", "assumption_based_finding"]
        },
        "detail": { "$ref": "#/$defs/text" },
        "resolution": { "$ref": "#/$defs/text" },
        "coverage_id": { "$ref": "#/$defs/coverage_id" }
      }
    }
  }
}
